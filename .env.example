# API
PORT=4000

# Storage (SiteGround PHP API)
# file (default) uses `data/state.json`
# mysql stores the same JSON state in a single MySQL row (see docs/mysql-state-store.sql)
BDK_STORAGE=file

# MySQL (required when BDK_STORAGE=mysql)
BDK_DB_HOST=localhost
BDK_DB_PORT=3306
BDK_DB_NAME=bdk_bms
BDK_DB_USER=bdk_bms_user
BDK_DB_PASS=change_me

# Web
VITE_API_BASE_URL=http://localhost:4000
