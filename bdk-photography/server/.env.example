# Server
PORT=4000
NODE_ENV=development

# Prisma (MySQL)
DATABASE_URL="mysql://bdk:bdk@127.0.0.1:3306/bdk_photography"

# Auth (JWT)
# Use a long random string (>=32 chars)
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET_STRING"
JWT_EXPIRES_IN="12h"

# Optional: allow only specific origins (comma-separated)
# CORS_ORIGIN="http://localhost:5173"

# Seed (runs once / idempotent)
SEED_ADMIN_FULL_NAME="System Admin"
SEED_ADMIN_PHONE="0700000000"
SEED_ADMIN_PASSWORD="change_me_please"

