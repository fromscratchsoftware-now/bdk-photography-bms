# API
PORT=4000

# Storage (SiteGround PHP API)
# file (default) uses `data/state.json`
# mysql stores the same JSON state in a single MySQL row (see docs/mysql-state-store.sql)
BDK_STORAGE=file

# MySQL (required when BDK_STORAGE=mysql)
BDK_DB_HOST=localhost
BDK_DB_PORT=3306
BDK_DB_NAME=bdk_bms
BDK_DB_USER=bdk_bms_user
BDK_DB_PASS=change_me

# API mode
# - (empty): legacy JSON-state API
# - phase1: MySQL relational schema + JWT auth endpoints (/api/auth/*, /api/shops, /api/users)
BDK_API_MODE=phase1

# JWT (Phase 1)
# Use a long random secret (>=32 chars)
BDK_JWT_SECRET=change_me_to_a_long_random_secret_string
# Token TTL in seconds (default 12h)
BDK_JWT_TTL_SECONDS=43200

# Seed (Phase 1)
SEED_ADMIN_FULL_NAME="System Admin"
SEED_ADMIN_PHONE=0700000000
SEED_ADMIN_PASSWORD=change_me_please

# Web
VITE_API_BASE_URL=http://localhost:4000
